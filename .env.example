# Local development: set the three MAGIX_ADMIN variables. Without GitHub settings,
# catalogue edits and uploads are stored under data/ on this machine.
MAGIX_ADMIN_USERNAME=replace-with-admin-username
MAGIX_ADMIN_PASSWORD=replace-with-a-strong-unique-password
MAGIX_SESSION_SECRET=replace-with-at-least-32-random-characters

# Required together for durable production publishing on Vercel.
# Use a fine-grained token scoped to this repository with Contents read/write.
GITHUB_MAGIX_REPO=owner/repository
GITHUB_MAGIX_TOKEN=replace-with-repository-scoped-token
GITHUB_MAGIX_BRANCH=main
GITHUB_MAGIX_PATH=data/catalog.json
GITHUB_MAGIX_UPLOAD_PATH=data/uploads
